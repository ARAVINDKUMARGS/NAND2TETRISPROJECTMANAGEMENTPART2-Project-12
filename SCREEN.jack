class Screen {
    function void clearScreen() {
        do Sys.clearScreen();
        return;
    }

    function void drawPixel(int x, int y, int color) {
        do Sys.drawPixel(x, y, color);
        return;
    }

    function void drawLine(int x1, int y1, int x2, int y2, int color) {
        do Sys.drawLine(x1, y1, x2, y2, color);
        return;
    }
}
